{
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.preferences.quoteStyle": "double",
  "js/ts.format.semicolons": "insert",
  "js/ts.tsserver.experimental.enableProjectDiagnostics": true,
  "js/ts.implicitProjectConfig.target": "ES2018",
  "chat.tools.terminal.autoApprove": { "/^pnpm exec tsc --noEmit$/": { "approve": true, "matchCommandLine": true } },
  "nixEnvSelector.nixFile": "${workspaceFolder}/flake.nix",
  "nixEnvSelector.useFlakes": true,
  "nixEnvSelector.flakeShell": "default",
  "editor.defaultFormatter": "rvest.vs-code-prettier-eslint",
  "eslint.format.enable": true,
  "eslint.run": "onSave",
  "vs-code-prettier-eslint.prettierLast": false, // set as "true" to run 'prettier' last not first
  "[typescript]": {
    "editor.formatOnType": false, // required
    "editor.formatOnPaste": false, // optional
    "editor.formatOnSave": true, // optional
    "editor.formatOnSaveMode": "file", // required to format on save
    "files.autoSave": "onFocusChange" // optional but recommended
  }
}
