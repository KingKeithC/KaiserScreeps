{
  "version": "2.0.0",
  "tasks": [
    { "type": "npm", "script": "push", "problemMatcher": [], "label": "push" },
    { "type": "npm", "script": "build", "problemMatcher": [], "label": "build" },
    {
      "type": "process",
      "command": "rm",
      "args": ["-r", "dist/", "node_modules/"],
      "problemMatcher": [],
      "label": "clean"
    },
    {
      "type": "npm",
      "label": "npm: lint",
      "script": "lint",
      "problemMatcher": "$eslint-stylish",
      "options": { "cwd": "${workspaceFolder}" }
    },
    { "type": "npm", "script": "push-sim", "problemMatcher": [], "label": "push-sim" },
    { "type": "npm", "script": "watch-sim", "problemMatcher": [], "label": "watch-sim" }
  ]
}
